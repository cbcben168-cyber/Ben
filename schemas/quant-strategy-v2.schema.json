{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quant-strategy/v2",
  "title": "quant-strategy/v2 contract",
  "description": "Generated-equivalent document for the frozen V2 root, enum, and AST definitions. Runtime validation is contract-equivalent, not a complete Draft 2020-12 evaluator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "strategy_id",
    "strategy_family",
    "strategy_name",
    "symbol",
    "market",
    "timeframe",
    "session",
    "backtest_range",
    "initial_capital",
    "entry",
    "exit",
    "filters",
    "position_sizing",
    "stop",
    "target",
    "fill_timing",
    "data",
    "benchmark",
    "plugin",
    "optimization_allowed",
    "report_language"
  ],
  "properties": {
    "schema_version": { "enum": ["v2.1"] },
    "strategy_id": { "type": "string", "minLength": 1 },
    "strategy_family": { "type": "string", "minLength": 1 },
    "strategy_name": { "type": "string", "minLength": 1 },
    "symbol": { "type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$" },
    "market": { "enum": ["US_EQUITY"] },
    "timeframe": { "enum": ["1d", "15m", "30m", "60m"] },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timezone", "regular_hours_only", "calendar_id"],
      "properties": {
        "timezone": { "const": "America/New_York" },
        "regular_hours_only": { "const": true },
        "calendar_id": { "type": "string", "minLength": 1 }
      }
    },
    "backtest_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "string", "format": "date" },
        "end": { "type": "string", "format": "date" }
      }
    },
    "initial_capital": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "const": 100000 },
        "currency": { "const": "USD" }
      }
    },
    "entry": { "type": "object" },
    "exit": { "type": "object" },
    "filters": { "type": "array", "items": { "type": "object" } },
    "position_sizing": { "type": "object" },
    "stop": { "type": "object" },
    "target": { "type": "object" },
    "fill_timing": { "enum": ["next_bar_open"] },
    "data": { "type": "object" },
    "benchmark": { "type": "object" },
    "plugin": { "type": ["object", "null"] },
    "optimization_allowed": { "const": false },
    "report_language": { "enum": ["zh-CN"] }
  },
  "$defs": {
    "indicator_ref": {
      "category": "ValueExpression",
      "required_fields": ["node_type", "name", "parameters", "output", "unit"],
      "output_type": "value",
      "additional_properties": false
    },
    "constant": {
      "category": "ValueExpression",
      "required_fields": ["node_type", "value", "unit"],
      "output_type": "value",
      "additional_properties": false
    },
    "price_ref": {
      "category": "ValueExpression",
      "required_fields": ["node_type", "field", "unit"],
      "output_type": "value",
      "additional_properties": false
    },
    "volume_ref": {
      "category": "ValueExpression",
      "required_fields": ["node_type", "field", "unit"],
      "output_type": "value",
      "additional_properties": false
    },
    "compare": {
      "category": "PredicateExpression",
      "required_fields": ["node_type", "operator", "left", "right"],
      "output_type": "predicate",
      "additional_properties": false
    },
    "cross_above": {
      "category": "PredicateExpression",
      "required_fields": ["node_type", "left", "right"],
      "output_type": "predicate",
      "additional_properties": false
    },
    "cross_below": {
      "category": "PredicateExpression",
      "required_fields": ["node_type", "left", "right"],
      "output_type": "predicate",
      "additional_properties": false
    },
    "all": {
      "category": "PredicateExpression",
      "required_fields": ["node_type", "children"],
      "output_type": "predicate",
      "additional_properties": false
    },
    "any": {
      "category": "PredicateExpression",
      "required_fields": ["node_type", "children"],
      "output_type": "predicate",
      "additional_properties": false
    },
    "not": {
      "category": "PredicateExpression",
      "required_fields": ["node_type", "child"],
      "output_type": "predicate",
      "additional_properties": false
    }
  }
}
